{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "course-study.schema.json",
  "title": "Frozen paired course study",
  "type": "object",
  "required": ["schema_version", "id", "status", "paired_seeds", "environments", "budget", "pcqn_arms", "checkpoint_selection", "final_evaluation", "analysis"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "status": {"const": "frozen"},
    "frozen_on": {"type": "string", "format": "date"},
    "purpose": {"type": "string", "minLength": 1},
    "paired_seeds": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
    "environments": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["env_id", "protocol"]}},
    "budget": {"type": "object", "required": ["training_interactions", "learning_starts", "train_frequency", "curriculum_update_frequency", "curriculum_episodes_per_preference", "validation_frequency", "validation_episodes_per_preference", "final_episodes_per_preference", "tuning_runs_per_environment"]},
    "pcqn_arms": {"type": "array", "minItems": 1},
    "comparators": {"type": "array"},
    "excluded_comparators": {"type": "array"},
    "checkpoint_selection": {"type": "object"},
    "final_evaluation": {"type": "object"},
    "analysis": {"type": "object"}
  },
  "additionalProperties": false
}
