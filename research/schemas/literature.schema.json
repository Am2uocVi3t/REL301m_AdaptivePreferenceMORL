{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "literature.schema.json",
  "title": "Literature metadata registry",
  "type": "object",
  "required": ["schema_version", "papers"],
  "properties": {
    "schema_version": {"const": 1},
    "papers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "authors", "year", "source_type", "status", "url", "note"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
          "title": {"type": "string", "minLength": 1},
          "authors": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "year": {"type": "integer", "minimum": 1900},
          "source_type": {"enum": ["peer-reviewed", "preprint", "benchmark", "software", "venue-policy"]},
          "status": {"enum": ["queued", "screened", "read", "excluded"]},
          "url": {"type": "string", "minLength": 1},
          "note": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
