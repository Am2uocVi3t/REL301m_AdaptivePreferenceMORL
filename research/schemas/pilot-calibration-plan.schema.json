{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pilot-calibration-plan.schema.json",
  "title": "Pilot-only reward-scale and hypervolume calibration plan",
  "type": "object",
  "required": [
    "schema_version",
    "name",
    "status",
    "source_split",
    "method",
    "seeds",
    "training",
    "evaluation",
    "calibration_rule",
    "smoke",
    "environments",
    "review_gate"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "name": {"type": "string", "minLength": 1},
    "status": {"const": "predeclared"},
    "purpose": {"type": "string", "minLength": 1},
    "source_split": {"const": "validation"},
    "forbidden_split": {"const": "test"},
    "method": {"const": "uniform-pcqn"},
    "seeds": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "integer"}
    },
    "training": {
      "type": "object",
      "required": ["total_timesteps", "learning_starts", "train_freq", "batch_size", "buffer_capacity"],
      "properties": {
        "total_timesteps": {"type": "integer", "minimum": 1},
        "learning_starts": {"type": "integer", "minimum": 1},
        "train_freq": {"type": "integer", "minimum": 1},
        "batch_size": {"type": "integer", "minimum": 1},
        "buffer_capacity": {"type": "integer", "minimum": 1}
      }
    },
    "evaluation": {
      "type": "object",
      "required": ["episodes_per_preference", "seed_base", "shift"],
      "properties": {
        "episodes_per_preference": {"type": "integer", "minimum": 1},
        "seed_base": {"type": "integer"},
        "shift": {"const": "nominal"}
      }
    },
    "calibration_rule": {
      "type": "object",
      "required": [
        "return_field",
        "scale_abs_quantile",
        "magnitude_floor",
        "reference_span_quantiles",
        "reference_margin_fraction",
        "reference_minimum_margin"
      ],
      "properties": {
        "return_field": {"const": "episode_returns"},
        "scale_abs_quantile": {"type": "number", "exclusiveMinimum": 0.5, "exclusiveMaximum": 1.0},
        "magnitude_floor": {"type": "number", "exclusiveMinimum": 0.0},
        "reference_span_quantiles": {
          "type": "array",
          "prefixItems": [
            {"type": "number", "minimum": 0.0, "maximum": 1.0},
            {"type": "number", "minimum": 0.0, "maximum": 1.0}
          ],
          "items": false
        },
        "reference_margin_fraction": {"type": "number", "exclusiveMinimum": 0.0},
        "reference_minimum_margin": {"type": "number", "exclusiveMinimum": 0.0}
      }
    },
    "smoke": {
      "type": "object",
      "required": ["total_timesteps", "learning_starts", "episodes_per_preference", "evidence_status"]
    },
    "environments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["env_id", "protocol"],
        "properties": {
          "env_id": {"type": "string", "minLength": 1},
          "protocol": {"type": "string", "minLength": 1}
        }
      }
    },
    "review_gate": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
