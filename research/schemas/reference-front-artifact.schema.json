{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reference-front-artifact.schema.json",
  "title": "Versioned deterministic environment reference front",
  "type": "object",
  "required": ["schema_version", "kind", "env_id", "reward_dim", "return_definition", "generator", "plan_sha256", "protocol_sha256", "points", "points_sha256", "provenance"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "environment_reference_front"},
    "env_id": {"type": "string", "minLength": 1},
    "reward_dim": {"type": "integer", "minimum": 2},
    "return_definition": {
      "type": "object",
      "required": ["type", "gamma"],
      "properties": {"type": {"const": "discounted"}, "gamma": {"type": "number", "exclusiveMinimum": 0.0, "maximum": 1.0}}
    },
    "generator": {"type": "object"},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "protocol_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "points": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "array", "minItems": 2, "items": {"type": "number"}}
    },
    "points_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provenance": {"type": "object"}
  }
}
